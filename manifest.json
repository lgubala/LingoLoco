{
  "manifest_version": 3,
  "name": "Buzz Kill",
  "version": "2.0.0",
  "description": "Replace any word on any page with a word of your own. Runs locally, nothing leaves your browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "buzzkill@local.extension",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core/namespace.js",
        "core/rules.js",
        "core/settings.js",
        "core/schedule.js",
        "core/matcher.js",
        "core/sites.js",
        "content/skip.js",
        "content/rewrite.js",
        "content/observe.js",
        "content/main.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Buzz Kill",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
